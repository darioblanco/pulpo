#!/usr/bin/env bash
set -euo pipefail

echo "==> Pre-commit: checking formatting..."
cargo fmt --all -- --check
(cd web && npx prettier --check .)

echo "==> Pre-commit: running clippy..."
cargo clippy --workspace --all-targets -- -D warnings

echo "==> Pre-commit: running ESLint + TypeScript check..."
(cd web && npx eslint . && npx tsc --noEmit)

echo "==> Pre-commit: running tests..."
# pulpo-e2e (the end-to-end scenario suite) is excluded here — it needs
# pulpod/pulpo/fake-claude pre-built at fixed paths and a real tmux server, and the
# full suite takes roughly a minute; run it manually with `make e2e` before a PR
# that touches session/watchdog/harness/schedule behavior. See CLAUDE.md's Testing
# section.
cargo test --workspace --exclude pulpo-e2e
(cd web && PATH=/usr/local/bin:$PATH NODE_OPTIONS=--experimental-require-module NODE_PATH=./vendor npx vitest run --passWithNoTests)

if [ "${SKIP_RUST_COVERAGE:-0}" = "1" ]; then
  echo "==> Pre-commit: skipping Rust coverage (SKIP_RUST_COVERAGE=1)"
else
  echo "==> Pre-commit: checking Rust coverage..."
  make coverage-rust
fi

echo "==> All checks passed."

# Prune stale build artifacts (>7 days) so target/ doesn't pile up (non-blocking)
if command -v cargo-sweep >/dev/null 2>&1; then
  cargo sweep --recursive --time 7 . >/dev/null 2>&1 || true
fi
